<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulation Boucle Incendie</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #1e1e1e; color: white; }
        /* Canvas behavior update: prevent default selection behaviors */
        canvas { background-color: #000; border: 1px solid #444; touch-action: none; }
        .panel { background-color: #2d2d2d; padding: 15px; border-radius: 8px; margin-bottom: 10px; }
        .status-led { width: 15px; height: 15px; border-radius: 50%; display: inline-block; margin-right: 8px; }
        .led-green { background-color: #00ff00; box-shadow: 0 0 5px #00ff00; }
        .led-red { background-color: #ff0000; box-shadow: 0 0 10px #ff0000; animation: blink 0.5s infinite; }
        .led-yellow { background-color: #ffcc00; box-shadow: 0 0 5px #ffcc00; }
        .led-off { background-color: #333; box-shadow: none; animation: none; }
        
        @keyframes blink { 50% { opacity: 0.3; } }
        
        button { transition: all 0.2s; }
        button:active { transform: scale(0.95); }
    </style>
</head>
<body class="p-4 flex flex-col items-center min-h-screen">

    <div class="w-full max-w-4xl">
        <h1 class="text-2xl font-bold mb-4 text-center text-gray-200">Simulation : Boucle de Détection Incendie</h1>
        
        <!-- Status Panel imitating the Fire Control Panel -->
        <div class="panel flex flex-col md:flex-row justify-between items-center shadow-lg gap-4">
            <div class="text-lg font-semibold md:border-r border-gray-600 pr-4 text-center md:text-left">
                <div class="text-xs text-gray-400 uppercase">État de la Centrale</div>
                <div id="systemState" class="text-green-400 text-xl font-bold mt-1">VEILLE (NORMAL)</div>
                <div id="voltageDisplay" class="text-xs text-gray-500 mt-1">24.0 V</div>
            </div>
            
            <div class="flex space-x-6">
                <div class="flex flex-col items-center">
                    <div id="led-fire" class="status-led led-off"></div>
                    <span class="text-xs mt-1">FEU</span>
                </div>
                <div class="flex flex-col items-center">
                    <div id="led-fault" class="status-led led-off"></div>
                    <span class="text-xs mt-1">DÉFAUT</span>
                </div>
                <div class="flex flex-col items-center">
                    <div id="led-short" class="status-led led-off"></div>
                    <span class="text-xs mt-1">COURT-CIRCUIT</span>
                </div>
                <div class="flex flex-col items-center">
                    <div id="led-power" class="status-led led-green"></div>
                    <span class="text-xs mt-1">SOUS TENSION</span>
                </div>
            </div>

            <div class="text-right md:border-l border-gray-600 pl-4 w-full md:w-auto">
                <div class="text-xs text-gray-400">Courant de boucle</div>
                <div id="currentVal" class="font-mono text-cyan-400 text-2xl">0.00 mA</div>
            </div>
        </div>

        <!-- Canvas for the Circuit Simulation -->
        <div class="relative group w-full">
            <!-- Added w-full and strict aspect ratio container if needed, but standard canvas logic below handles resizing -->
            <canvas id="circuitCanvas" width="800" height="400" class="w-full h-auto rounded shadow-xl bg-black"></canvas>
            <div class="absolute top-2 right-2 text-xs text-gray-500 bg-black bg-opacity-70 p-2 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                💡 Astuce : Cliquez sur les boîtiers rouges ou les fils
            </div>
        </div>

        <!-- Advanced Controls -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            
            <!-- Physics Controls -->
            <div class="bg-gray-800 p-4 rounded border border-gray-700">
                <h3 class="font-bold text-sm text-blue-400 mb-3 border-b border-gray-700 pb-2">Paramètres Physiques</h3>
                
                <div class="mb-4">
                    <label class="flex justify-between text-xs text-gray-400 mb-1">
                        <span>Tension Source (Volts)</span>
                        <span id="lblVoltage">24V</span>
                    </label>
                    <input type="range" id="sliderVoltage" min="0" max="30" step="0.5" value="24" 
                           class="w-full h-2 bg-gray-600 rounded-lg appearance-none cursor-pointer"
                           oninput="updateParams()">
                </div>

                <div class="mb-4">
                    <label class="flex justify-between text-xs text-gray-400 mb-1">
                        <span>Résistance Fin de Ligne (Ohms)</span>
                        <span id="lblResistance">3300Ω</span>
                    </label>
                    <input type="range" id="sliderResistance" min="100" max="10000" step="100" value="3300" 
                           class="w-full h-2 bg-gray-600 rounded-lg appearance-none cursor-pointer"
                           oninput="updateParams()">
                    <div class="flex justify-between text-[10px] text-gray-500 mt-1">
                        <span>Court-jus</span>
                        <span>Standard (3.3k)</span>
                        <span>Coupure</span>
                    </div>
                </div>
            </div>

            <!-- Simulation Actions -->
            <div class="bg-gray-800 p-4 rounded border border-gray-700">
                <h3 class="font-bold text-sm text-yellow-400 mb-3 border-b border-gray-700 pb-2">Simulations & Actions</h3>
                
                <div class="grid grid-cols-2 gap-3">
                    <button onclick="toggleWireCut()" id="btnCut" class="bg-gray-700 hover:bg-gray-600 text-white px-3 py-2 rounded text-sm transition-colors border border-gray-600">
                        ⚡ Simuler Coupure
                    </button>
                    
                    <button onclick="toggleShortCircuit()" id="btnShort" class="bg-gray-700 hover:bg-red-900 text-white px-3 py-2 rounded text-sm transition-colors border border-gray-600">
                        🔥 Simuler Court-Circuit
                    </button>

                    <button onclick="resetSim()" class="col-span-2 bg-blue-600 hover:bg-blue-500 text-white font-bold px-3 py-2 rounded text-sm mt-2 shadow-lg transform active:scale-95 transition-all flex justify-center items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        RÉARMER LE SYSTÈME
                    </button>
                </div>

                <div class="mt-4 text-xs text-gray-500 bg-gray-900 p-2 rounded border border-gray-800">
                    <strong>Logique de détection :</strong><br>
                    • I < 2mA : Défaut (Ouverture)<br>
                    • 4mA < I < 12mA : Normal (Veille)<br>
                    • 15mA < I < 100mA : FEU (Alarme)<br>
                    • I > 150mA : Court-Circuit
                </div>
            </div>
        </div>
    </div>

<script>
    const canvas = document.getElementById('circuitCanvas');
    const ctx = canvas.getContext('2d');
    
    // Default Circuit Parameters
    let vSource = 24; // Volts
    const R_ALARM = 470; // Ohms
    let rEol = 3300;  // Ohms
    
    // State
    let switch1 = false;
    let switch2 = false;
    let wireCut = false;
    let shortCircuit = false;
    
    // Coordinates for interactivity
    const coords = {
        dm1: { x: 230, y: 120, w: 90, h: 160 }, // Box coords
        dm2: { x: 430, y: 120, w: 90, h: 160 },
        wireTop: { x1: 90, y: 100, x2: 700 }, // Y is 100 approx +- 10px click area
        wireBot: { x1: 90, y: 300, x2: 700 }
    };

    let current = 0; 
    let dotsOffset = 0;
    
    // UI Elements
    const elSystemState = document.getElementById('systemState');
    const elCurrentVal = document.getElementById('currentVal');
    const elVoltageDisplay = document.getElementById('voltageDisplay');
    
    const elLedFire = document.getElementById('led-fire');
    const elLedFault = document.getElementById('led-fault');
    const elLedShort = document.getElementById('led-short');
    const elLedPower = document.getElementById('led-power');
    
    const btnCut = document.getElementById('btnCut');
    const btnShort = document.getElementById('btnShort');
    
    const sliderVoltage = document.getElementById('sliderVoltage');
    const sliderResistance = document.getElementById('sliderResistance');
    const lblVoltage = document.getElementById('lblVoltage');
    const lblResistance = document.getElementById('lblResistance');

    function updateParams() {
        vSource = parseFloat(sliderVoltage.value);
        rEol = parseInt(sliderResistance.value);
        
        lblVoltage.innerText = vSource + "V";
        lblResistance.innerText = rEol + "Ω";
        
        // Power LED logic
        if(vSource < 5) {
            elLedPower.className = "status-led led-off";
        } else if (vSource < 18) {
            elLedPower.className = "status-led led-yellow"; // Low bat
        } else {
            elLedPower.className = "status-led led-green";
        }
        
        updateCircuit();
    }

    function resetSim() {
        switch1 = false;
        switch2 = false;
        wireCut = false;
        shortCircuit = false;
        
        // Reset controls visuals
        btnCut.classList.remove('bg-yellow-600', 'text-black', 'font-bold');
        btnCut.classList.add('bg-gray-700', 'text-white');
        btnCut.innerText = "⚡ Simuler Coupure";
        
        btnShort.classList.remove('bg-red-600', 'text-white', 'font-bold', 'animate-pulse');
        btnShort.classList.add('bg-gray-700', 'text-white');
        btnShort.innerText = "🔥 Simuler Court-Circuit";

        // Reset sliders to default standard
        sliderVoltage.value = 24;
        sliderResistance.value = 3300;
        updateParams();
    }

    function toggleWireCut() {
        wireCut = !wireCut;
        // Turn off short circuit if wire is cut (physics!)
        if(wireCut) shortCircuit = false; 
        
        updateButtonState(btnCut, wireCut, "Coupure Active", "⚡ Simuler Coupure", "bg-yellow-600");
        updateButtonState(btnShort, shortCircuit, "Court-Circuit Actif", "🔥 Simuler Court-Circuit", "bg-red-600");
        updateCircuit();
    }

    function toggleShortCircuit() {
        shortCircuit = !shortCircuit;
        if(shortCircuit) wireCut = false; 
        
        updateButtonState(btnShort, shortCircuit, "Court-Circuit Actif", "🔥 Simuler Court-Circuit", "bg-red-600");
        updateButtonState(btnCut, wireCut, "Coupure Active", "⚡ Simuler Coupure", "bg-yellow-600");
        updateCircuit();
    }

    function updateButtonState(btn, isActive, activeText, inactiveText, activeClass) {
        if(isActive) {
            btn.innerText = activeText;
            btn.classList.remove('bg-gray-700');
            btn.classList.add(activeClass, 'font-bold');
            if(activeClass.includes('red')) btn.classList.add('animate-pulse');
        } else {
            btn.innerText = inactiveText;
            btn.classList.add('bg-gray-700');
            btn.classList.remove(activeClass, 'font-bold', 'animate-pulse');
        }
    }

    function calculateState() {
        let r_loop = Infinity;

        if (wireCut) {
            r_loop = Infinity;
        } else if (shortCircuit) {
            r_loop = 0.1; 
        } else if (switch1 || switch2) {
            // R_ALARM parallel to R_EOL
            r_loop = (R_ALARM * rEol) / (R_ALARM + rEol);
        } else {
            r_loop = rEol;
        }

        if (vSource === 0) current = 0;
        else current = vSource / r_loop;

        const mA = current * 1000;

        if (vSource < 5) return "OFF";
        if (mA > 150) return "SHORT";
        if (mA >= 15) return "FIRE";       
        if (mA >= 2 && mA < 15) return "NORMAL"; 
        return "FAULT"; 
    }

    // Global variable to hold current state string for canvas drawing
    let currentSystemState = "NORMAL";

    function updateCircuit() {
        const state = calculateState();
        currentSystemState = state;
        
        elVoltageDisplay.innerText = vSource.toFixed(1) + " V";
        elCurrentVal.innerText = (current * 1000).toFixed(1) + " mA";

        elLedFire.className = "status-led led-off";
        elLedFault.className = "status-led led-off";
        elLedShort.className = "status-led led-off";

        if (state === "NORMAL") {
            elSystemState.innerText = "VEILLE (NORMAL)";
            elSystemState.className = "text-green-400 text-xl font-bold mt-1";
        } 
        else if (state === "FIRE") {
            elSystemState.innerText = "ALARME FEU !";
            elSystemState.className = "text-red-500 text-xl font-bold mt-1 blink";
            elLedFire.className = "status-led led-red";
        } 
        else if (state === "FAULT") {
            elSystemState.innerText = "DÉFAUT LIGNE";
            elSystemState.className = "text-yellow-400 text-xl font-bold mt-1";
            elLedFault.className = "status-led led-yellow";
        }
        else if (state === "SHORT") {
            elSystemState.innerText = "DÉFAUT C.C. (COURT-CIRCUIT)";
            elSystemState.className = "text-red-400 text-xl font-bold mt-1 animate-pulse";
            elLedShort.className = "status-led led-red";
            elLedFault.className = "status-led led-yellow";
        }
        else if (state === "OFF") {
            elSystemState.innerText = "HORS TENSION";
            elSystemState.className = "text-gray-500 text-xl font-bold mt-1";
        }
    }

    // --- DRAWING ---
    function draw() {
        ctx.fillStyle = "#000";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const busTopY = 100;
        const busBotY = 300;
        const endX = 700;
        const dm1X = 250;
        const dm2X = 450;
        
        // --- Panel Drawing ---
        ctx.fillStyle = "#222";
        ctx.fillRect(10, 50, 80, 300);
        ctx.strokeStyle = vSource > 18 ? "#0f0" : "#555";
        ctx.strokeRect(10, 50, 80, 300);
        
        // Draw Panel Internal LEDs
        // Green Power LED
        ctx.beginPath();
        ctx.arc(50, 250, 5, 0, Math.PI*2);
        ctx.fillStyle = vSource > 18 ? "#00ff00" : "#333";
        ctx.fill();
        // Red Alarm LED
        ctx.beginPath();
        ctx.arc(50, 270, 5, 0, Math.PI*2);
        ctx.fillStyle = currentSystemState === "FIRE" ? "#ff0000" : "#333";
        ctx.fill();
        // Yellow Fault LED
        ctx.beginPath();
        ctx.arc(50, 290, 5, 0, Math.PI*2);
        ctx.fillStyle = (currentSystemState === "FAULT" || currentSystemState === "SHORT") ? "#ffcc00" : "#333";
        ctx.fill();

        ctx.fillStyle = "#fff";
        ctx.textAlign = "center";
        ctx.fillText("CENTRALE", 50, 80);
        ctx.font = "12px monospace";
        ctx.fillStyle = "#aaa";
        ctx.fillText(vSource + "V", 50, 100);

        // --- Wires ---
        let wireColor = '#00ccff';
        if (shortCircuit) wireColor = '#ff3333'; 
        if (vSource < 2) wireColor = '#333';

        const dWire = (x1,y1,x2,y2, cut) => {
             ctx.beginPath();
             ctx.strokeStyle = cut ? '#333' : wireColor;
             ctx.lineWidth = shortCircuit ? 5 : 3; 
             if(cut) {
                 const midX = (x1+x2)/2; const midY = (y1+y2)/2;
                 ctx.moveTo(x1, y1); ctx.lineTo(midX-5, midY);
                 ctx.moveTo(midX+5, midY); ctx.lineTo(x2, y2);
                 // X mark
                 ctx.save(); ctx.strokeStyle='red'; ctx.lineWidth=2;
                 ctx.moveTo(midX-5, midY-5); ctx.lineTo(midX+5, midY+5);
                 ctx.moveTo(midX+5, midY-5); ctx.lineTo(midX-5, midY+5);
                 ctx.restore();
             } else {
                 ctx.moveTo(x1, y1); ctx.lineTo(x2, y2);
             }
             ctx.stroke();
        };

        // Main Bus
        dWire(90, busTopY, endX, busTopY, wireCut);
        dWire(90, busBotY, endX, busBotY, false);

        // EOL Leg
        dWire(endX, busTopY, endX, 180, false);
        dWire(endX, 220, endX, busBotY, false);
        drawResistor(ctx, endX - 10, 180, 20, 40, "EOL " + rEol + "Ω");

        // DM1
        // Highlight box if switch is active
        drawBox(ctx, coords.dm1.x, coords.dm1.y, coords.dm1.w, coords.dm1.h, "DM 1", switch1);
        dWire(dm1X, busTopY, dm1X, busTopY + 40, false);
        drawSwitch(ctx, dm1X - 25, busTopY + 40, !switch1, "S1");
        dWire(dm1X, busTopY + 40, dm1X, busTopY + 90, false);
        drawResistor(ctx, dm1X - 15, busTopY + 90, 30, 20, "470Ω");
        dWire(dm1X, busTopY + 110, dm1X, busBotY, false);

        // DM2
        drawBox(ctx, coords.dm2.x, coords.dm2.y, coords.dm2.w, coords.dm2.h, "DM 2", switch2);
        dWire(dm2X, busTopY, dm2X, busTopY + 40, false);
        drawSwitch(ctx, dm2X - 25, busTopY + 40, !switch2, "S2");
        dWire(dm2X, busTopY + 40, dm2X, busTopY + 90, false);
        drawResistor(ctx, dm2X - 15, busTopY + 90, 30, 20, "470Ω");
        dWire(dm2X, busTopY + 110, dm2X, busBotY, false);

        // Short Circuit Visual
        if(shortCircuit) {
            ctx.font = "30px Arial";
            ctx.fillStyle = "yellow";
            ctx.fillText("⚡", endX/2, busTopY);
            ctx.fillText("⚡", endX/2, busBotY);
            
            // Draw a short bar
            ctx.strokeStyle = "orange";
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(600, busTopY);
            ctx.lineTo(600, busBotY);
            ctx.stroke();
            ctx.fillStyle = "orange";
            ctx.font = "bold 16px Arial";
            ctx.fillText("COURT-CIRCUIT!", 600, (busTopY+busBotY)/2);
        }

        // --- Animation ---
        let speed = 0;
        const mA = current * 1000;
        
        if (mA > 1000) speed = 30; // Short circuit
        else if (mA > 10) speed = 8; // Fire
        else if (mA > 1) speed = 1.5; // Normal
        else speed = 0;

        dotsOffset += speed;

        if (speed > 0 && !shortCircuit) {
            // Main loop path
            if(!wireCut) {
                drawCurrentDots(ctx, [[90, busTopY], [endX, busTopY], [endX, 180]], speed, true);
                drawCurrentDots(ctx, [[endX, 220], [endX, busBotY], [90, busBotY]], speed, true);
            }
            if(switch1) {
                drawCurrentDots(ctx, [[90, busTopY], [dm1X, busTopY], [dm1X, busTopY+40]], speed, true);
                drawCurrentDots(ctx, [[dm1X, busTopY+40], [dm1X, busBotY], [90, busBotY]], speed, true);
            }
            if(switch2) {
                drawCurrentDots(ctx, [[90, busTopY], [dm2X, busTopY], [dm2X, busTopY+40]], speed, true);
                drawCurrentDots(ctx, [[dm2X, busTopY+40], [dm2X, busBotY], [90, busBotY]], speed, true);
            }
        } else if (shortCircuit) {
             drawCurrentDots(ctx, [[90, busTopY], [600, busTopY]], speed, true);
             drawCurrentDots(ctx, [[600, busTopY], [600, busBotY]], speed, true);
             drawCurrentDots(ctx, [[600, busBotY], [90, busBotY]], speed, true);
        }

        requestAnimationFrame(draw);
    }
    
    // Helpers
    function drawResistor(ctx, x, y, width, height, label) {
        ctx.beginPath();
        ctx.strokeStyle = '#aaa';
        ctx.lineWidth = 2;
        const segments = 6;
        const segWidth = width / segments;
        ctx.moveTo(x, y);
        for(let i=0; i<=segments; i++) {
            const yOffset = (i%2===0 ? -height/2 : height/2);
            if (i===0 || i===segments) ctx.lineTo(x + i*segWidth, y);
            else ctx.lineTo(x + i*segWidth, y + yOffset);
        }
        ctx.stroke();
        if(label) {
            ctx.fillStyle = "#aaa"; ctx.font = "10px Arial"; ctx.textAlign = "center";
            ctx.fillText(label, x + width/2, y - 10);
        }
    }
    function drawSwitch(ctx, x, y, isOpen, label) {
        ctx.strokeStyle = 'white'; ctx.lineWidth = 2; ctx.beginPath();
        ctx.moveTo(x, y); ctx.lineTo(x + 10, y);
        ctx.moveTo(x + 40, y); ctx.lineTo(x + 50, y);
        ctx.stroke();
        ctx.beginPath(); ctx.moveTo(x + 10, y);
        if (isOpen) ctx.lineTo(x + 35, y - 15);
        else ctx.lineTo(x + 40, y);
        ctx.stroke();
        ctx.fillStyle = "white"; ctx.font = "12px Arial"; ctx.textAlign = "center";
        ctx.fillText(label, x + 25, y - 25);
        if(isOpen) {
             ctx.fillStyle = "#ff4444"; ctx.fillRect(x + 15, y - 40, 20, 10);
             ctx.beginPath(); ctx.moveTo(x+25, y-30); ctx.lineTo(x+25, y-20); ctx.stroke();
        }
    }
    function drawBox(ctx, x, y, w, h, label, active) {
        ctx.strokeStyle = active ? '#ffaaaa' : '#ff4444'; 
        ctx.lineWidth = active ? 3 : 2; 
        ctx.setLineDash([5, 3]);
        ctx.strokeRect(x, y, w, h); ctx.setLineDash([]);
        
        // Fill slight background if active
        if(active) {
            ctx.fillStyle = "rgba(255, 50, 50, 0.2)";
            ctx.fillRect(x,y,w,h);
        }

        ctx.fillStyle = '#ff4444'; ctx.font = "bold 12px Arial"; ctx.textAlign = "left";
        ctx.fillText(label, x + 5, y + 15);
    }
    function drawCurrentDots(ctx, path, speed, show) {
        if (!show) return;
        ctx.fillStyle = shortCircuit ? '#ff5500' : '#ffcc00';
        let totalLen = 0; let dists = [0];
        for(let i=0; i<path.length-1; i++) {
            const d = Math.hypot(path[i+1][0]-path[i][0], path[i+1][1]-path[i][1]);
            totalLen += d; dists.push(totalLen);
        }
        const dotSpacing = shortCircuit ? 10 : 20;
        const numDots = Math.floor(totalLen / dotSpacing);
        const move = (dotsOffset) % dotSpacing;
        for(let i=0; i<numDots; i++) {
            let dist = (i * dotSpacing + move) % totalLen;
            let seg = 0; while(dists[seg+1] < dist) seg++;
            const frac = (dist - dists[seg]) / (dists[seg+1] - dists[seg]);
            const x = path[seg][0] + (path[seg+1][0] - path[seg][0]) * frac;
            const y = path[seg][1] + (path[seg+1][1] - path[seg][1]) * frac;
            ctx.beginPath(); ctx.arc(x, y, shortCircuit ? 3 : 2, 0, Math.PI*2); ctx.fill();
        }
    }

    // --- INTERACTION HELPER ---
    // Correctly map mouse position to canvas coordinates regardless of CSS size
    function getMousePos(canvas, evt) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        return {
            x: (evt.clientX - rect.left) * scaleX,
            y: (evt.clientY - rect.top) * scaleY
        };
    }
    
    // Check hitboxes
    function isInside(pos, box) {
        return pos.x > box.x && pos.x < box.x + box.w &&
               pos.y > box.y && pos.y < box.y + box.h;
    }

    // Interaction
    canvas.addEventListener('mousedown', (e) => {
        const pos = getMousePos(canvas, e);
        
        // Click DM1 Box
        if (isInside(pos, coords.dm1)) { 
            switch1 = !switch1; 
            updateCircuit(); 
        }
        // Click DM2 Box
        if (isInside(pos, coords.dm2)) { 
            switch2 = !switch2; 
            updateCircuit(); 
        }
    });
    
    // Hover Effects (Cursor)
    canvas.addEventListener('mousemove', (e) => {
        const pos = getMousePos(canvas, e);
        let hovering = false;
        if (isInside(pos, coords.dm1) || isInside(pos, coords.dm2)) {
            hovering = true;
        }
        canvas.style.cursor = hovering ? 'pointer' : 'default';
    });

    // Start
    updateParams();
    draw();
</script>
</body>
</html>
